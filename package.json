{
	"name": "showmethepicture",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env --import tsx src/lib/server/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"test:schema": "node --env-file-if-exists=.env --import tsx scripts/test-schema-pglite.ts",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-pgvector": "^0.0.9",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Self-hosted photo portfolio: original/edit toggle, Korean semantic search, film-strip landing",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.10.1",
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"drizzle-orm": "^0.45.3",
		"exiftool-vendored": "^39.0.1",
		"hash-wasm": "^4.12.0",
		"pg-boss": "^12.37.0",
		"postgres": "^3.4.9",
		"pretendard": "^1.3.9",
		"sharp": "^0.35.5",
		"thumbhash": "^0.1.1",
		"tsx": "^4.23.15",
		"ulid": "^3.0.2",
		"zod": "^4.6.5"
	}
}
