# compose.yaml 의 ${...} 에 들어가는 "인프라" 값. 서버에서 docker compose 를 직접 쓰면 .env 로 복사하고,
# Portainer 웹 에디터 스택이면 Environment variables 에 같은 이름으로 넣거나 compose 본문에 값을 직접 써도 된다.
# 사진 폴더 등록, 사이트 제목, 공개 정책, 검색 모델 같은 앱 설정은 여기가 아니라 관리자 페이지에서 바꾼다.

# GitHub Actions 가 ghcr.io/nr2bj/showmethepicture 로 올리는 이미지 태그 (latest | sha-xxxxxxx | v0.1.0)
APP_TAG=latest

# 호스트 경로
#  - PHOTOS_HOST_PATH: 넓게 잡는다(풀 전체나 photo123 의 부모). 컨테이너에는 /photos 로 read-only 마운트.
#    실제 폴더(Source)는 앱의 폴더 선택기로 고른다.
#  - CACHE_HOST_PATH: 파생 이미지(thumb/preview/full). 반드시 SSD. HDD 풀에 두지 말 것.
PHOTOS_HOST_PATH=/mnt/pool
CACHE_HOST_PATH=/srv/showmethepicture/cache

# 컨테이너가 돌아갈 uid/gid. 사진 파일 소유자와 맞춘다 (ls -ln 으로 확인). 캐시 폴더 소유권은 기동 시 자동으로 맞춘다.
PUID=1000
PGID=1000

# Postgres (db 서비스). DATABASE_URL 은 compose 가 이 값들로 조립한다.
POSTGRES_USER=smtp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smtp

# 공개 주소
#  - APP_PORT: app 이 호스트에 여는 포트. 외부 reverse proxy(LXC 의 Caddy 등)가 http://<VM IP>:APP_PORT 로 프록시한다.
#  - ORIGIN: 사용자가 보는 공개 origin. 프록시 뒤라도 반드시 공개 URL 로 (예: https://photos.example.com)
APP_PORT=3000
ORIGIN=https://photos.example.com

# compose.caddy.yaml(스택 안 caddy) 을 쓸 때만: caddy 가 듣는 주소. 도메인이면 자동 TLS, 내부망이면 :80
# SITE_ADDRESS=photos.example.com

# Immich machine-learning 이미지 버전. 운영 전 실제 태그로 고정 권장 (예: v2.x.y)
IMMICH_ML_VERSION=release
